# Copy to .env and edit. .env is git-ignored; never commit real secrets.
# Load with:  cd backend && uvicorn main:app --env-file ../.env

# Browser origin(s) allowed to call the API (comma-separated).
FRONTEND_ORIGIN=http://localhost:5173

# Rate limit for POST /api/predict, per client IP. Format: "<count>/<period>".
PREDICT_RATE_LIMIT=30/minute

# Rate limit for POST /api/extract-url (link input), per client IP.
URL_RATE_LIMIT=10/minute

# Rate limit for POST /api/feedback, per client IP.
FEEDBACK_RATE_LIMIT=20/minute

# Where thumbs up/down + comments are appended (one line each). Default: feedback.txt
# in the project root. Git-ignored because it contains user comments.
# FEEDBACK_FILE=feedback.txt
